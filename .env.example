# Copy to .env and adjust. Loaded by scripts/dev-api.ps1 (never by the binary —
# the binary reads real environment variables).

# Accounts: username:password:Display Name:role  — separated by ';'
# No field may contain ':' or ';'. Exactly one admin is expected.
AUTH_USERS=admin:admin:Petr Admin:admin;jan:jan:Jan Novák:editor;eva:eva:Eva Dvořáková:editor

# Holds app.db and attachments/. Created if missing.
DATA_DIR=./data

API_PORT=9998

# 0 means: do not open the SPA listener at all. That is what development needs,
# because Vite already owns 9999 and two processes cannot bind the same port.
# In production leave this at 9999 — it serves the embedded SPA *and* /api.
WEB_PORT=0

# Origins allowed to call the API listener cross-origin with credentials.
# Empty (the normal case) emits no CORS headers at all; '*' is rejected.
# CORS_ORIGINS=http://vyvoj-srv:9999

# MAX_UPLOAD_BYTES=104857600
# MAX_ATTACHMENTS_PER_REQUEST=20
# MAX_REQUEST_BYTES=536870912
# SESSION_TTL_HOURS=720
# ARCHIVE_AFTER_DAYS=365
